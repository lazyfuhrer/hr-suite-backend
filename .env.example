# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
LOG_REQUEST_BODY=false
CORS_ORIGIN=*

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=hr_management_dev

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=30d

# Refresh Token (rotating)
# Opaque refresh tokens expire after this many seconds.
REFRESH_TOKEN_EXPIRES_IN_SECONDS=2592000

# AWS S3 (Optional - required for file uploads)
AWS_REGION=us-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET=your_s3_bucket_name
S3_PUBLIC_URL=https://your-s3-bucket.s3.region.amazonaws.com
S3_UPLOAD_MAX_MB=20
REKOGNITION_COLLECTION_ID=collection-id


# Notification en vars
MSG91_AUTH_KEY=MSG91_AUTH_KEY
WEB_LOGIN_URL=WEB_LOGIN_URL
IOS_APP_URL=IOS_APP_URL
ANDROID_APP_URL=hANDROID_APP_URL

# Firebase / Push notifications (FCM)
# Store the full Firebase service account JSON as a single env var.
# Keep newline characters in private_key escaped as \n.
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your_firebase_project_id","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk@example.iam.gserviceaccount.com"}
# Internal-only key required for POST /api/notifications/trigger
INTERNAL_NOTIFICATIONS_KEY=change_me_to_a_long_random_value

# Sandbox KYC
# Uses only these 3 vars.
# Switch SANDBOX_PROFILE between TEST and PROD as needed.
SANDBOX_PROFILE=TEST
SADBOX_API_KEY=SADBOX_API_KEY
SANDBOX_API_SECRET=SANDBOX_API_SECRET
# Optional local/dev bypass for Sandbox KYC provider calls.
# When true, Aadhaar OTP + Aadhaar verify OTP + PAN verify return mocked success.
SANDBOX_KYC_MOCK_MODE=false

# External KYC provider (optional)
# Used by src/services/kycVerification.service.ts for identity/bank verification.
KYC_API_URL=https://kyc-provider.example.com
KYC_API_KEY=your_kyc_api_key