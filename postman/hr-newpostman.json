        {
            "name": "Geofence Management",
            "item": [
                {
                    "name": "Create Geofence",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{tokenB}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/geofences",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "geofences"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\"org_id\":\"{{orgId}}\",\"user_id\":\"{{userId}}\",\"landmark\":\"Park Street Gate\",\"latitude\":22.5726,\"longitude\":88.3639,\"radius_meters\":100}"
                        },
                        "description": "Create a user-scoped geofence from latitude, longitude, and landmark.\n\nPOST /api/geofences\nAuth: admin, hr, or manager only.\nBody: org_id (required, must match JWT org), user_id (required), landmark (required), latitude, longitude, radius_meters (optional, default 100).\nGeofence is created for the specified user in the caller's org."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const json = pm.response.json();",
                                    "if (json.id) {",
                                    "  pm.collectionVariables.set('geofenceId', json.id);",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "List Geofences",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{tokenB}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/geofences",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "geofences"
                            ]
                        },
                        "description": "List all geofences for the authenticated tenant org.\n\nGET /api/geofences"
                    }
                },
                {
                    "name": "Get Geofence by ID",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{tokenB}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/geofences/{{geofenceId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "geofences",
                                "{{geofenceId}}"
                            ]
                        },
                        "description": "Get a single geofence by id (org-scoped).\n\nGET /api/geofences/:id"
                    }
                },
                {
                    "name": "Update Geofence",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{tokenB}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/geofences/{{geofenceId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "geofences",
                                "{{geofenceId}}"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\"org_id\":\"{{orgId}}\",\"user_id\":\"{{userId}}\",\"landmark\":\"Updated Park Street Gate\",\"latitude\":22.5726,\"longitude\":88.3639,\"radius_meters\":150}"
                        },
                        "description": "Full replace of a user-scoped geofence.\n\nPUT /api/geofences/:id\nAuth: admin, hr, or manager only.\nBody: org_id (required, must match JWT org), user_id (required), landmark (required), latitude, longitude, radius_meters (optional, default 100).\nGeofence is updated for the specified user in the caller's org."
                    }
                },
                {
                    "name": "List Geofence Events (Admin/HR/Manager)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{tokenB}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/geofences/events?userId={{userId}}&date=2026-09-02&page=1&limit=25",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "geofences",
                                "events"
                            ],
                            "query": [
                                {
                                    "key": "userId",
                                    "value": "{{userId}}"
