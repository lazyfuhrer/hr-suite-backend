        {
            "name": "Upload Extra Employee Document (shows in employee-overview)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{tokenC}}",
                        "description": "Tenant Admin, HR, Manager, or Employee token"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/onboarding/employee/documents/upload-extra",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "onboarding",
                        "employee",
                        "documents",
                        "upload-extra"
                    ]
                },
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "aadhar_front",
                            "type": "file",
                            "src": [],
                            "description": "Upload any additional document using one of the supported keys: aadhar_front, aadhar_back, pan_card, passport_size_photo, passport, marksheet_10th, marksheet_12th, degree_certificate, previous_offer_letters, experience_letter, salary_slip_month_1, salary_slip_month_2, salary_slip_month_3."
                        }
                    ]
                },
                "description": "Let the current user upload an extra onboarding document for themselves.\n\nFor this endpoint, the file is stored in S3 using the original filename (sanitized) without a timestamp prefix, under orgs/{org_id}/users/{user_id}/documents/{CATEGORY}/{fieldName}/{original_file_name}.\n\nA matching record is saved in user_documents with the appropriate doc_category/doc_type so it automatically appears inside the `documents` object of `GET {{baseUrl}}/api/onboarding/{{userId}}/employee-overview` for this user."
            }
        },
        {
            "name": "Device Face Clock (In/Out via Face)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{tokenB}}",
                        "description": "Tenant Admin or Device token required"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/attendance/device/face-clock",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "attendance",
                        "device",
                        "face-clock"
                    ]
                },
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "image",
                            "type": "file",
                            "src": [],
                            "description": "Captured face image file (required)."
                        },
                        {
                            "key": "threshold",
                            "type": "text",
                            "value": "90",
                            "description": "Optional similarity threshold (0-100) for Rekognition matching (default ~90)."
                        }
                    ]
                },
                "description": "Admin/Device endpoint for in-office device facial attendance.\n\nAuth:\n- Allowed roles: admin, device\n\nFlow:\n1) Device captures employee face and sends the image file directly as form-data.\n2) Backend uploads the image to S3, uses AWS Rekognition SearchFacesByImage on the configured collection, and maps the match via user_face_embeddings.\n3) If this is the user's first attendance log for today, they are clocked in; if they are already clocked in, they are clocked out.\n\nForm-data fields:\n- image (file, required): Captured face image.\n- threshold (text, optional): Rekognition similarity threshold (0-100, default ~90).\n\nIf org setting `face_clock_enabled` is false, this endpoint returns 403."
            }
        },
        {
            "name": "Face Clock - Location Verify (Employee/Manager/HR)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{tokenC}}",
                        "description": "Tenant Employee, Manager, or HR token required"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/attendance/face-clock/location-verify",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "attendance",
                        "face-clock",
                        "location-verify"
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"latitude\": 22.5726,\n  \"longitude\": 88.3639\n}"
                },
                "description": "Step 1 for user face clock-in flow. Verify whether current coordinates are eligible for clock-in for the logged-in employee/manager/hr. Returns 403 when org setting `face_clock_enabled` is false."
            }
        },
        {
            "name": "Face Verify & Clock In (Employee/Manager/HR)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{tokenC}}",
                        "description": "Tenant Employee, Manager, or HR token required"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/attendance/face-clock/verify-and-clock-in",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "attendance",
                        "face-clock",
                        "verify-and-clock-in"
                    ]
                },
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "image",
                            "type": "file",
                            "src": [],
                            "description": "Selfie/face image file for verification (required)."
                        },
                        {
                            "key": "threshold",
                            "type": "text",
                            "value": "90",
                            "description": "Optional similarity threshold (0-100)."
                        }
                    ]
                },
                "description": "Step 2 for user face clock-in flow. Matches uploaded face with logged-in user's indexed passport photo face and clocks the user in on success. Returns 403 when org setting `face_clock_enabled` is false."
            }
        },
