                            "src": [],
                            "description": "Identity Category"
                        },
                        {
                            "key": "aadhar_back",
                            "type": "file",
                            "src": [],
                            "description": "Identity Category"
                        },
                        {
                            "key": "pan_card",
                            "type": "file",
                            "src": [],
                            "description": "Identity Category"
                        },
                        {
                            "key": "passport_size_photo",
                            "type": "file",
                            "src": [],
                            "description": "Identity Category. When provided, the backend automatically generates and stores a facial embedding for this user."
                        },
                        {
                            "key": "marksheet_10th",
                            "type": "file",
                            "src": [],
                            "description": "Education Category"
                        },
                        {
                            "key": "marksheet_12th",
                            "type": "file",
                            "src": [],
                            "description": "Education Category"
                        },
                        {
                            "key": "degree_certificate",
                            "type": "file",
                            "src": [],
                            "description": "Education Category"
                        },
                        {
                            "key": "experience_letter",
                            "type": "file",
                            "src": [],
                            "description": "Experience Category"
                        },
                        {
                            "key": "salary_slip_month_1",
                            "type": "file",
                            "src": [],
